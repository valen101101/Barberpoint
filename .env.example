# Copiar este archivo a .env.local y completar con los datos del proyecto
# Supabase (Project Settings > API en supabase.com).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Secreta — nunca se expone al navegador. El server la usa para hablar con
# Supabase sin depender de RLS por rol (los barberos no usan Supabase Auth,
# ver CLAUDE.md sección 2 "Login propio").
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cualquier cadena larga y random, para firmar la cookie de sesión propia.
# Generarla, por ejemplo, con: openssl rand -base64 32
SESSION_SECRET=
